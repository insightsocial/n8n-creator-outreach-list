    {
      "parameters": {
        "jsCode": "// One search per keyword. Each costs 340 to 420 credits (see the README).\nconst cfg = $input.first().json;\nreturn String(cfg.keywords || '')\n  .split(',')\n  .map(k => k.trim())\n  .filter(Boolean)\n  .map(keyword => ({ json: { keyword, date_posted: cfg.date_posted } }));"
      },
      "id": "ad4f4138-8813-5a59-b303-b26a3eb8317c",
      "name": "One search per keyword",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://api.insightsocial.app/v1/instagram/search/reels",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.keyword }}"
            },
            {
              "name": "date_posted",
              "value": "={{ $json.date_posted }}"
            },
            {
              "name": "include",
              "value": "creator"
            },
            {
              "name": "relevance",
              "value": "filter"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-insightsocial-client",
              "value": "n8n-creator-outreach-list/1.0.0"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "83b39a8b-e23f-5cbb-aa3c-c80b4b271fe1",
      "name": "Instagram: Reels + creator cards",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "InsightSocial API"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Turns every keyword's Reels into one row per creator. Costs nothing.\nconst cfg = $('Your search').first().json;\nconst asked = $('One search per keyword').all().map(i => i.json.keyword);\n\nconst WEBMAIL = /@(gmail|googlemail|hotmail|outlook|live|yahoo|icloud|me|aol|proton|protonmail|gmx|yandex|mail)\\./i;\nconst MANAGER = /@[^@]*(talent|mgmt|management|agency|collective|marketing|entertainment)[^@]*$/i;\n\n// Cuts by character, not UTF-16 unit, so an emoji is never split in half.\nconst cut = (s, n) => Array.from(s).slice(0, n).join('');\n\nfunction emailType(email) {\n  if (!email) return '';\n  if (WEBMAIL.test(email)) return 'personal inbox';\n  if (MANAGER.test(email)) return 'manager or agency';\n  return 'own domain';\n}\n\nconst min = Number(cfg.min_followers) || 0;\nconst max = Number(cfg.max_followers) || Infinity;\nconst countries = String(cfg.countries || '').split(',').map(c => c.trim().toLowerCase()).filter(Boolean);\n\nconst creators = new Map();\nlet credits = 0, reels = 0, searched = 0;\n$input.all().forEach((item, i) => {\n  const res = item.json || {};\n  if (!res.data) return;\n  searched++;\n  credits += res.credits_used || 0;\n  for (const row of res.data.items || []) {\n    reels++;\n    const p = row.post || {};\n    const x = p.ext || {};\n    const handle = p.author && p.author.username;\n    if (!handle) continue;\n    const likes = p.engagement && p.engagement.likes;\n    const seen = creators.get(handle);\n    if (seen) {\n      if (!seen.keywords.includes(asked[i])) seen.keywords.push(asked[i]);\n      if ((likes || 0) > (seen.reel_likes || 0)) Object.assign(seen, { reel_url: p.url, reel_likes: likes, reel_posted: p.published_at });\n      continue;\n    }\n    creators.set(handle, {\n      handle,\n      name: (p.author && p.author.display_name) || '',\n      profile_url: 'https://www.instagram.com/' + handle + '/',\n      followers: x.author_followers == null ? null : Number(x.author_followers),\n      country: x.author_country || '',\n      email: x.author_public_email || '',\n      email_type: emailType(x.author_public_email),\n      phone: x.author_public_phone || '',\n      posts: x.author_posts_count == null ? null : Number(x.author_posts_count),\n      keywords: [asked[i]],\n      reel_url: p.url || '',\n      reel_likes: likes == null ? null : Number(likes),\n      reel_posted: p.published_at || '',\n      reel_caption: cut(((p.content && p.content.text) || '').replace(/\\s+/g, ' ').trim(), 200),\n    });\n  }\n});\n\nconst rows = [...creators.values()]\n  .filter(c => c.followers == null || (c.followers >= min && c.followers <= max))\n  .filter(c => !countries.length || !c.country || countries.includes(c.country.toLowerCase()))\n  .filter(c => !cfg.only_with_email || c.email)\n  .sort((a, b) => (b.email ? 1 : 0) - (a.email ? 1 : 0) || (b.followers || 0) - (a.followers || 0))\n  .map(c => ({ ...c, keywords: c.keywords.join(', '), found_on: $now.toISODate() }));\n\nconsole.log(`Searched ${searched} keywords, read ${reels} Reels, ${creators.size} creators, kept ${rows.length}, ${credits} credits.`);\nreturn rows.map(json => ({ json }));"
      },
